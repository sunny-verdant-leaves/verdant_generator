{
  "plugins": [
    {
      "type": "recipe_generator",
      "template": "templates/recipes/material.json",
      "output_name": "material.json",
      "default_namespace": "minecraft",
      "trees": []
    },
    {
      "type": "recipe_generator",
      "template": "templates/recipes/{modid}_{tree}_door.json",
      "output_name": "{modid}_{tree}_door.json",
      "default_namespace": "minecraft",
      "trees": []
    },
    {
      "type": "recipe_generator",
      "template": "templates/recipes/{tree}.json",
      "output_name": "{tree}.json",
      "default_namespace": "minecraft",
      "trees": []
    }
  ]
}